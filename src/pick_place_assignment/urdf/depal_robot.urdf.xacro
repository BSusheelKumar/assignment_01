<?xml version="1.0"?>
<robot name="crx10ia_l" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find fanuc_crx_description)/urdf/crx10ia_l_urdf_macro.xacro"/>

  <link name="world"/>

  <!-- Pedestal 0.4 x 0.4 x 0.75 m -->
  <link name="pedestal">
    <visual>
      <origin xyz="0 0 0.375"/>
      <geometry><box size="0.4 0.4 0.75"/></geometry>
      <material name="grey"><color rgba="0.35 0.35 0.4 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.375"/>
      <geometry><box size="0.4 0.4 0.75"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.375"/>
      <mass value="50"/>
      <inertia ixx="3.0" iyy="3.0" izz="1.3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="world_to_pedestal" type="fixed">
    <parent link="world"/>
    <child link="pedestal"/>
  </joint>

  <link name="ee_link"/>
  <xacro:crx10ia_l parent="world" child="ee_link">
    <origin xyz="0 0 .75" rpy="0 0 0"/>
  </xacro:crx10ia_l>

  <!-- ===== Vacuum gripper (z = outward from the flange) =====
       adapter 0-0.04 | plate 0.04-0.06 | 4 cups 0.06-0.08 | cup face = tcp at z 0.08 -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="dark"><color rgba="0.2 0.2 0.22 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.20 0.12 0.02"/></geometry>
      <material name="plate"><color rgba="0.6 0.6 0.65 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.07 0.035 0.07"/>
      <geometry><cylinder radius="0.022" length="0.02"/></geometry>
      <material name="cup"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin xyz="-0.07 0.035 0.07"/>
      <geometry><cylinder radius="0.022" length="0.02"/></geometry>
      <material name="cup"/>
    </visual>
    <visual>
      <origin xyz="0.07 -0.035 0.07"/>
      <geometry><cylinder radius="0.022" length="0.02"/></geometry>
      <material name="cup"/>
    </visual>
    <visual>
      <origin xyz="-0.07 -0.035 0.07"/>
      <geometry><cylinder radius="0.022" length="0.02"/></geometry>
      <material name="cup"/>
    </visual>
    <visual> <!-- vacuum hose port -->
      <origin xyz="0.05 0 0.03" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.007" length="0.05"/></geometry>
      <material name="hose"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.20 0.12 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="1.0"/>
      <inertia ixx="0.00173" iyy="0.00387" izz="0.00453" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="ee_to_gripper" type="fixed">
    <parent link="ee_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0" rpy="3.14 0 0"/>
  </joint>

  <link name="tcp"/>
  <joint name="gripper_to_tcp" type="fixed">
    <parent link="gripper_link"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.08"/>
  </joint>

  <!-- Keep gripper_link as a real Gazebo link (otherwise it is merged into J6) -->
  <gazebo reference="ee_to_gripper">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- ros2_control (Gazebo Fortress) -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <xacro:macro name="jt" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:jt name="J1"/><xacro:jt name="J2"/><xacro:jt name="J3"/>
    <xacro:jt name="J4"/><xacro:jt name="J5"/><xacro:jt name="J6"/>
  </ros2_control>

  <gazebo>
    <plugin filename="libign_ros2_control-system.so"
            name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find pick_place_assignment)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Our vacuum gripper plugin -->
  <gazebo>
    <plugin filename="vacuum_gripper" name="depal::VacuumGripper">
      <link_name>gripper_link</link_name>
      <cup_offset>0 0 0.08</cup_offset>
      <attach_distance>0.015</attach_distance>
      <filter>box</filter>
      <enable_topic>/vacuum/enable</enable_topic>
      <state_topic>/vacuum/attached</state_topic>
    </plugin>
  </gazebo>
</robot>