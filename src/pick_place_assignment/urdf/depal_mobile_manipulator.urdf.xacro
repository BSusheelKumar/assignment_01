<?xml version="1.0"?>
<robot name="depal_mobile_manipulator" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find fanuc_crx_description)/urdf/crx10ia_l_urdf_macro.xacro"/>

  <!--
    Drive base follows the proven BCR Bot ROS 2 / Fortress arrangement:
    two powered wheels, passive ball casters, and the Ignition DiffDrive system.
    Reference: https://github.com/blackcoffeerobotics/bcr_bot/tree/ros2
  -->

  <!-- Differential-drive chassis: x is forward, y is left, z is up. -->
  <link name="chassis_link">
    <visual><origin xyz="0 0 0.145"/><geometry><box size="0.90 0.64 0.19"/></geometry>
      <material name="chassis_blue"><color rgba="0.12 0.25 0.48 1"/></material></visual>
    <collision><origin xyz="0 0 0.145"/><geometry><box size="0.90 0.64 0.19"/></geometry></collision>
    <inertial><origin xyz="0 0 0.145"/><mass value="55"/>
      <inertia ixx="2.045" ixy="0" ixz="0" iyy="3.878" iyz="0" izz="5.590"/></inertial>
  </link>

  <xacro:macro name="drive_wheel" params="name y">
    <link name="${name}">
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.10" length="0.05"/></geometry>
        <material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material></visual>
      <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.10" length="0.05"/></geometry></collision>
      <inertial><mass value="1.0"/><inertia ixx="0.00255" ixy="0" ixz="0" iyy="0.0051" iyz="0" izz="0.00255"/></inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="chassis_link"/><child link="${name}"/><origin xyz="0 ${y} 0.10"/><axis xyz="0 1 0"/>
      <limit effort="200" velocity="20"/><dynamics damping="0.02" friction="0.0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel name="left_wheel" y="0.36"/>
  <xacro:drive_wheel name="right_wheel" y="-0.36"/>
  <gazebo reference="left_wheel"><mu1>5.0</mu1><mu2>5.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>5.0</mu1><mu2>5.0</mu2></gazebo>

  <!-- Passive support casters keep the chassis stable without affecting steering. -->
  <xacro:macro name="ball_caster" params="name x y">
    <link name="${name}"><visual><geometry><sphere radius="0.06"/></geometry><material name="caster"><color rgba="0.2 0.2 0.2 1"/></material></visual>
      <collision><geometry><sphere radius="0.06"/></geometry></collision>
      <inertial><mass value="0.1"/><inertia ixx="0.000144" ixy="0" ixz="0" iyy="0.000144" iyz="0" izz="0.000144"/></inertial></link>
    <joint name="${name}_joint" type="fixed"><parent link="chassis_link"/><child link="${name}"/><origin xyz="${x} ${y} 0.06"/></joint>
    <gazebo reference="${name}"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:ball_caster name="front_left_caster" x="0.43" y="0.41"/>
  <xacro:ball_caster name="front_right_caster" x="0.43" y="-0.41"/>
  <xacro:ball_caster name="rear_left_caster" x="-0.43" y="0.41"/>
  <xacro:ball_caster name="rear_right_caster" x="-0.43" y="-0.41"/>

  <!-- Reuse the existing CRX10iA/L arm and gripper geometry, mounted on the chassis deck. -->
  <link name="arm_mount_link"/>
  <joint name="chassis_to_arm_mount" type="fixed"><parent link="chassis_link"/><child link="arm_mount_link"/><origin xyz="-0.02 0 0.24"/></joint>
  <link name="ee_link"/>
  <xacro:crx10ia_l parent="arm_mount_link" child="ee_link"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:crx10ia_l>

  <link name="gripper_link">
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.04" length="0.04"/></geometry><material name="dark"><color rgba="0.2 0.2 0.22 1"/></material></visual>
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.20 0.12 0.02"/></geometry><material name="plate"><color rgba="0.6 0.6 0.65 1"/></material></visual>
    <visual><origin xyz="0.07 0.035 0.07"/><geometry><cylinder radius="0.022" length="0.02"/></geometry><material name="cup"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <visual><origin xyz="-0.07 0.035 0.07"/><geometry><cylinder radius="0.022" length="0.02"/></geometry><material name="cup"/></visual>
    <visual><origin xyz="0.07 -0.035 0.07"/><geometry><cylinder radius="0.022" length="0.02"/></geometry><material name="cup"/></visual>
    <visual><origin xyz="-0.07 -0.035 0.07"/><geometry><cylinder radius="0.022" length="0.02"/></geometry><material name="cup"/></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><box size="0.20 0.12 0.08"/></geometry></collision>
    <inertial><origin xyz="0 0 0.04"/><mass value="1.0"/><inertia ixx="0.00173" ixy="0" ixz="0" iyy="0.00387" iyz="0" izz="0.00453"/></inertial>
  </link>
  <joint name="ee_to_gripper" type="fixed"><parent link="ee_link"/><child link="gripper_link"/><origin rpy="3.14 0 0"/></joint>
  <link name="tcp"/><joint name="gripper_to_tcp" type="fixed"><parent link="gripper_link"/><child link="tcp"/><origin xyz="0 0 0.08"/></joint>

  <!-- Forward-facing 2D lidar and RGB-D camera. -->
  <link name="lidar_link"><visual><geometry><cylinder radius="0.055" length="0.045"/></geometry><material name="sensor_black"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><geometry><cylinder radius="0.055" length="0.045"/></geometry></collision><inertial><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial></link>
  <!-- Front edge mount. A 270 degree field of view excludes the rear arc
       that can be occluded by the manipulator and prevents self returns. -->
  <joint name="lidar_joint" type="fixed"><parent link="chassis_link"/><child link="lidar_link"/><origin xyz="0.36 0 0.36"/></joint>
  <link name="depth_camera_link"><visual><geometry><box size="0.09 0.12 0.06"/></geometry><material name="camera_gray"><color rgba="0.25 0.25 0.28 1"/></material></visual>
    <collision><geometry><box size="0.09 0.12 0.06"/></geometry></collision><inertial><mass value="0.25"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial></link>
  <joint name="depth_camera_joint" type="fixed"><parent link="chassis_link"/><child link="depth_camera_link"/><origin xyz="0.36 0 0.42"/></joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>ign_ros2_control/IgnitionSystem</plugin></hardware>
    <xacro:macro name="jt" params="name"><joint name="${name}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint></xacro:macro>
    <xacro:jt name="J1"/><xacro:jt name="J2"/><xacro:jt name="J3"/><xacro:jt name="J4"/><xacro:jt name="J5"/><xacro:jt name="J6"/>
  </ros2_control>
  <gazebo><plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin"><parameters>$(find pick_place_assignment)/config/controllers.yaml</parameters></plugin></gazebo>
  <gazebo reference="ee_to_gripper"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo><plugin filename="vacuum_gripper" name="depal::VacuumGripper"><link_name>gripper_link</link_name><cup_offset>0 0 0.08</cup_offset><attach_distance>0.015</attach_distance><filter>box</filter><enable_topic>/vacuum/enable</enable_topic><state_topic>/vacuum/attached</state_topic></plugin></gazebo>

  <gazebo><plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.72</wheel_separation><wheel_radius>0.10</wheel_radius>
    <max_linear_velocity>0.5</max_linear_velocity><max_angular_velocity>1.5</max_angular_velocity>
    <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
    <frame_id>odom</frame_id><child_frame_id>chassis_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
  </plugin></gazebo>
  <gazebo reference="lidar_link"><sensor name="lidar" type="gpu_lidar"><pose>0 0 0 0 0 0</pose><topic>/scan</topic><update_rate>30</update_rate><always_on>true</always_on><visualize>true</visualize><ignition_frame_id>lidar_link</ignition_frame_id>
    <lidar><scan><horizontal><samples>541</samples><resolution>1</resolution><min_angle>-2.35619</min_angle><max_angle>2.35619</max_angle></horizontal></scan><range><min>0.20</min><max>12.0</max><resolution>0.01</resolution></range></lidar>
  </sensor></gazebo>
  <gazebo reference="depth_camera_link"><sensor name="depth_camera" type="depth_camera"><pose>0 0 0 0 0 0</pose><topic>/mobile_camera</topic><camera_info_topic>/mobile_camera/camera_info</camera_info_topic><update_rate>30</update_rate><always_on>true</always_on><ignition_frame_id>depth_camera_link</ignition_frame_id><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>8.0</far></clip></camera></sensor></gazebo>
</robot>
